# Whitelist: ignore everything, then allow only the tool's source. Key files, approvals, requests and generated
# output can therefore never be committed by accident.
/*
!/.gitignore
!/.dockerignore
!/Dockerfile
!/INSTALLATION_GUIDE.md
!/README.md
!/package.json
!/package-lock.json
!/tsconfig.json
!/src/
!/contract/
/contract/*
!/contract/signer-tools.compact
